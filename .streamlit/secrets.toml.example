# Salin file ini jadi "secrets.toml" (tanpa ".example") untuk development lokal.
# JANGAN commit file "secrets.toml" yang asli ke git -- itu sudah di-ignore
# lewat .gitignore.
#
# Untuk deploy di Streamlit Cloud, isi nilai yang sama ini lewat:
# App settings -> Secrets (lihat README.md bagian "Setup Proxy" untuk detail).

WEBSHARE_USERNAME = "isi-username-proxy-kamu"
WEBSHARE_PASSWORD = "isi-password-proxy-kamu"

# Opsional -- HANYA isi kalau proxy kamu berupa IP statis tetap (paket
# "Proxy List"/"Proxy Server", baik dari Webshare atau provider lain),
# BUKAN gateway rotating Webshare asli. Kalau kosong, dianggap rotating
# Webshare (WEBSHARE_USERNAME/PASSWORD saja sudah cukup).
# PROXY_HOST = "isi-ip-proxy-kamu"
# PROXY_PORT = "isi-port-proxy-kamu"

# --- Untuk fitur AI ---
GOOGLE_API_KEY = "isi-google-ai-studio-api-key-kamu"   # embedding saja
GROQ_API_KEY = "isi-groq-api-key-kamu"                 # ringkasan, FAQ & Q&A
PINECONE_API_KEY = "isi-pinecone-api-key-kamu"

# Opsional -- judul/metadata video otomatis (channel, durasi, views, tanggal
# upload asli). Tanpa ini app tetap jalan normal, cuma pakai judul manual dan
# tanggal proses untuk nama file. Ambil dari console.cloud.google.com (BUKAN
# Google AI Studio) -> enable "YouTube Data API v3" -> Credentials -> API Key.
# YOUTUBE_API_KEY = "isi-youtube-data-api-key-kamu"
